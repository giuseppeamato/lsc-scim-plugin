<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
	xmlns="http://lsc-project.org/XSD/lsc-scim-plugin-1.2.xsd" targetNamespace="http://lsc-project.org/XSD/lsc-scim-plugin-1.2.xsd"
	elementFormDefault="qualified" xmlns:jaxb="http://java.sun.com/xml/ns/jaxb"
	xmlns:lsc="http://lsc-project.org/XSD/lsc-core-2.2.xsd" jaxb:version="2.0">

	<xsd:import namespace="http://lsc-project.org/XSD/lsc-core-2.2.xsd" schemaLocation="lsc-core-2.2.xsd" />

	<xsd:element name="oauth2ConnectionSettings">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="tokenURL" type="xsd:string" minOccurs="0" maxOccurs="1" />
				<xsd:element name="token" type="xsd:string" minOccurs="0" maxOccurs="1" />
				<xsd:element name="scope" type="xsd:string" minOccurs="0" maxOccurs="1" />
				<xsd:element name="clientId" type="xsd:string" minOccurs="0" maxOccurs="1" />
				<xsd:element name="clientSecret" type="xsd:string" minOccurs="0" maxOccurs="1" />
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>

	<xsd:complexType name="schemasType">
		<xsd:sequence>
			<xsd:element name="namespace" type="namespaceType" minOccurs="0" maxOccurs="unbounded" />
		</xsd:sequence>
	</xsd:complexType>

	<xsd:complexType name="namespaceType">
		<xsd:sequence>
			<xsd:element name="alias" type="xsd:string" minOccurs="1" />
			<xsd:element name="uri" type="xsd:string" minOccurs="1" />
		</xsd:sequence>
	</xsd:complexType>
		
	<xsd:element name="scimServiceSettings">
		<xsd:complexType>
			<xsd:complexContent>
				<xsd:extension base="lsc:serviceType">
					<xsd:sequence>
						<xsd:element name="entity" type="xsd:string" minOccurs="1" />
						<xsd:element name="pivot" type="xsd:string" minOccurs="0" />
						<xsd:element name="sourcePivot" type="xsd:string" minOccurs="0" />
						<xsd:element name="sourceUUID" type="xsd:string" minOccurs="0" />
						<xsd:element name="cacheConnection" minOccurs="0">
							<xsd:complexType>
								<xsd:attribute name="reference" type="xsd:IDREF" use="required" />
								<xsd:attribute name="writeEnabled" type="xsd:boolean" use="required" />
							</xsd:complexType>
						</xsd:element>
						<xsd:element name="domain" type="xsd:string" minOccurs="0" />
						<xsd:element name="pageSize" type="xsd:int" minOccurs="0" />
						<xsd:element name="filter" type="xsd:string" minOccurs="0" />
						<xsd:element name="attributes" type="xsd:string" minOccurs="0" />
						<xsd:element name="excludedAttributes" type="xsd:string" minOccurs="0" />						
						<xsd:element name="schema" type="schemasType" minOccurs="0" />						
						<xsd:sequence>
							<xsd:element name="writableAttributes" type="lsc:valuesType" minOccurs="0" />
						</xsd:sequence>
					</xsd:sequence>
				</xsd:extension>
			</xsd:complexContent>
		</xsd:complexType>
	</xsd:element>
</xsd:schema>
